#cloud-config
package_update: true
package_upgrade: true
packages:
  - ca-certificates
  - curl
  - git
  - gnupg
  - caddy

write_files:
  - path: /etc/caddy/Caddyfile
    permissions: "0644"
    content: |
      ${domain_name} {
          header Strict-Transport-Security "max-age=63072000; includeSubDomains"
          handle_path /browser/* {
              forward_auth 127.0.0.1:8080 {
                  uri /api/auth/verify
                  header_up -Upgrade
                  header_up -Connection
              }
              reverse_proxy 127.0.0.1:6080 {
                  header_up -Cookie
              }
          }
          handle {
              reverse_proxy 127.0.0.1:8080
          }
      }

  - path: /etc/clauz3-dot.env
    permissions: "0600"
    content: |
      ANTHROPIC_API_KEY=${anthropic_api_key}
      CLAUZ3_ALLOWED_HOSTS=${domain_name},localhost,127.0.0.1,dot-workspace
      CLAUZ3_BROWSER_URL=https://${domain_name}/browser/vnc.html?autoconnect=true&resize=scale&path=browser/websockify
      CLAUZ3_DOT_DECISION_TOKEN=${decision_token}
      CLAUZ3_WORKSPACE_VOLUME=/var/lib/clauz3-dot/workspace
      CLAUZ3_DATA_VOLUME=/var/lib/clauz3-dot/data
      CLAUZ3_BROWSER_VOLUME=/var/lib/clauz3-dot/browser-profile

runcmd:
  - |
    set -euxo pipefail
    # Wait up to 120s for the persistent EBS volume attachment (/dev/nvme1n1 or /dev/xvdf)
    DEV=""
    for _ in $(seq 1 60); do
      if [ -b "/dev/nvme1n1" ]; then DEV="/dev/nvme1n1"; break; fi
      if [ -b "/dev/xvdf" ]; then DEV="/dev/xvdf"; break; fi
      sleep 2
    done
    if [ -z "$DEV" ]; then
      echo "Persistent EBS volume not attached within 120s; aborting startup" >&2
      exit 1
    fi
    blkid "$DEV" || mkfs.ext4 -L clauz3-data "$DEV"
    mkdir -p /var/lib/clauz3-dot
    grep -q '/var/lib/clauz3-dot' /etc/fstab || echo "LABEL=clauz3-data /var/lib/clauz3-dot ext4 defaults,nofail 0 2" >> /etc/fstab
    mount -a
    mountpoint -q /var/lib/clauz3-dot
    mkdir -p /var/lib/clauz3-dot/workspace /var/lib/clauz3-dot/data /var/lib/clauz3-dot/browser-profile
    chown -R 1000:1000 /var/lib/clauz3-dot
    # Install Docker & Docker Compose plugin
    curl -fsSL https://get.docker.com | sh
    systemctl enable --now docker
    # Clone Clauz3 and start the Dot stack
    mkdir -p /opt/clauz3
    if [ ! -d /opt/clauz3/.git ]; then
      git clone --branch "${clauz3_git_ref}" "${clauz3_repo_url}" /opt/clauz3
    fi
    cd /opt/clauz3
    docker compose --env-file /etc/clauz3-dot.env up -d --build
    systemctl restart caddy
