    "FilesystemEditFile": {
      "annotations": {
        "python_symbol": "cz3tools.filesystem.trusted.effects.edit_file",
        "source_sha256": "68da2804288df5830dcbe8e0ad1ad321f85acfa8062e5db42a00d173bb305b6b"
      },
      "attributes": {
        "new": {
          "annotations": {
            "python_parameter_kind": "POSITIONAL_OR_KEYWORD"
          },
          "description": "The new argument to cz3tools.filesystem.trusted.effects.edit_file.",
          "range": "string",
          "required": true,
          "slot_uri": "cz:cz3tools.filesystem.trusted.effects.edit_file.new"
        },
        "old": {
          "annotations": {
            "python_parameter_kind": "POSITIONAL_OR_KEYWORD"
          },
          "description": "The old argument to cz3tools.filesystem.trusted.effects.edit_file.",
          "range": "string",
          "required": true,
          "slot_uri": "cz:cz3tools.filesystem.trusted.effects.edit_file.old"
        },
        "path": {
          "annotations": {
            "python_parameter_kind": "POSITIONAL_OR_KEYWORD"
          },
          "description": "The path argument to cz3tools.filesystem.trusted.effects.edit_file.",
          "range": "string",
          "required": true,
          "slot_uri": "cz:cz3tools.filesystem.trusted.effects.edit_file.path"
        },
        "replace_all": {
          "annotations": {
            "python_default": "false",
            "python_parameter_kind": "POSITIONAL_OR_KEYWORD"
          },
          "description": "The replace_all argument to cz3tools.filesystem.trusted.effects.edit_file.",
          "range": "boolean",
          "required": false,
          "slot_uri": "cz:cz3tools.filesystem.trusted.effects.edit_file.replace_all"
        }
      },
      "class_uri": "cz:cz3tools.filesystem.trusted.effects.edit_file",
      "description": "Replace the exact text ``old`` with ``new`` in the existing file ``path``.\n\nOccurrences are counted at every position ``old`` starts, including\noverlapping ones (``\"aaa\"`` contains two occurrences of ``\"aa\"``). ``old``\nmust occur exactly once unless ``replace_all`` is true, in which case\nevery non-overlapping occurrence, taken left to right, is replaced, and at\nleast one must exist. Otherwise ``ValueError`` reports how many were\nfound and the file is unchanged. The file must exist and be writable;\nthis never creates one, and raises ``PermissionError`` rather than\nrewrite a read-only file. Line endings and permission bits are preserved.\n\nThe new contents are written to a temporary file in the same directory\nand then renamed over ``path``, so this needs write permission on the\ndirectory as well as the file, and a process killed between the write\nand the rename can leave a stray ``NAME.*.tmp`` sibling behind; the\nrename itself is atomic, so ``path`` is never left half-written.\n\nContracts see a read of ``path`` and a text write of ``new`` to ``path``.\n``must_not_write`` and ``write_length_at_most`` therefore check only the\ninserted text, not the resulting file. The temporary sibling is not seen:\nlike the parent directories ``write_file`` creates, it is not listed by\nexact-file contracts such as ``only_writes_files``. Its path starts with\n``path`` itself (``a.py`` gives ``a.py.<random>.tmp``), so any path-prefix\ncontract that admits ``path`` admits it too. A symlink at ``path`` is\nreplaced by a regular file holding the new contents (the link's target is\nnot changed), as are hard links; ownership is not preserved.",
      "is_a": "EffectCall"
    },
