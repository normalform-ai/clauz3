# Runner commands. Default to `uv run` for the source-checkout dev flow;
# `clauz3 test` overrides CLAUZ3 so the bundled suite also runs from an
# installed wheel, where `uv` is absent.
clauz3 := env_var_or_default("CLAUZ3", "uv run clauz3")

find_trusted := "../tools/find/trusted"
effects := find_trusted + "/effects.py"
# find imports the filesystem layer, so make it importable too.
prove := clauz3 + " prove --trusted-root " + find_trusted + " --import-root .. --import-root ../../filesystem"

test: lint cases

lint:
    {{clauz3}} lint {{effects}}

cases: only-read-under-pass only-read-under-fail never-read-under-pass never-read-under-fail searches-at-most-pass searches-at-most-fail

only-read-under-pass:
    {{prove}} cases/only_read_under_pass.py

only-read-under-fail:
    if {{prove}} cases/only_read_under_fail.py; then exit 1; fi

never-read-under-pass:
    {{prove}} cases/never_read_under_pass.py

never-read-under-fail:
    if {{prove}} cases/never_read_under_fail.py; then exit 1; fi

searches-at-most-pass:
    {{prove}} cases/searches_at_most_pass.py

searches-at-most-fail:
    if {{prove}} cases/searches_at_most_fail.py; then exit 1; fi
