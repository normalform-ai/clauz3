# Runner commands. Default to `uv run` for the source-checkout dev flow;
# `clauz3 test` overrides CLAUZ3/PYTHON so the suite also runs from an
# installed wheel, where `uv` is absent.
clauz3 := env_var_or_default("CLAUZ3", "uv run clauz3")
python := env_var_or_default("PYTHON", "uv run python")

trusted := "../cz3tools/google_workspace/gmail/trusted"
effects := trusted + "/effects.py"
# Proves each case in one process: *_pass.py must prove, *_fail.py must not.
prove-cases := python + " -m clauz3._prove_cases --trusted-root " + trusted + " --import-root .."

test: lint cases runtime

lint:
    {{clauz3}} lint {{effects}}

# Includes the signature regressions: the selected email layer must load even
# when the program never imports it (unused_email_pass.py), and send_email's
# preconditions refuse a bad recipient or an empty subject.
cases:
    {{prove-cases}} cases/*_pass.py cases/*_fail.py

# Runtime tests mock subprocess.run: no mailbox operations occur.
runtime:
    {{python}} -m unittest discover -s . -p 'test_*.py'
