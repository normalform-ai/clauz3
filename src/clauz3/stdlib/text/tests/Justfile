clauz3 := env_var_or_default("CLAUZ3", "uv run clauz3")
python := env_var_or_default("PYTHON", "uv run python")
trusted := "../tools/text/trusted"
prove := clauz3 + " prove --trusted-root " + trusted + " --import-root .. --import-root ../../filesystem"
# Proves each case in one process: *_pass.py must prove, *_fail.py must not.
prove-cases := python + " -m clauz3._prove_cases --trusted-root " + trusted + " --import-root .. --import-root ../../filesystem"

test: lint cases

lint:
    {{clauz3}} lint {{trusted}}/effects.py

cases:
    {{prove-cases}} cases/*_pass.py cases/*_fail.py
